# PostgreSQL 접속 주소
DATABASE_URL=postgres://maru:maru@localhost:5432/maruseum
# 테스트 전용 DB (npm test 가 이 DB를 비우고 다시 만듭니다)
TEST_DATABASE_URL=postgres://maru:maru@localhost:5432/maruseum_test

# ── 통화 녹음 요약 (Phase 3) ──────────────────────────────
# 음성 인식 (OpenAI). 키가 없으면 녹음 처리가 "실패"로 표시되고 안내 문구가 나옵니다.
OPENAI_API_KEY=
# 음성 인식 모델 (기본 whisper-1)
# STT_MODEL=whisper-1
# AI 요약 (Anthropic Claude)
ANTHROPIC_API_KEY=
# 요약 모델 (기본 claude-opus-5-5)
# SUMMARY_MODEL=claude-opus-5-5
# 녹음 파일 저장 폴더 (백업되는 디스크로 지정 권장)
RECORDINGS_DIR=./storage/recordings
# 음성 파일 보관 일수 (지나면 음성만 삭제, 녹취록·요약은 유지). 0 이면 자동 삭제 안 함
RECORDING_AUDIO_RETENTION_DAYS=180
# 개발·데모용: 외부 API 대신 고정 결과 사용 (mock)
# STT_PROVIDER=mock
# SUMMARY_PROVIDER=mock
